# Copiar este archivo como .env y ajustar los valores:  cp .env.example .env
# OJO: el .env NO se sube a git (tiene contraseñas). Este .env.example sí.
#
# Las contraseñas de las bases, de pgAdmin y del usuario web de Airflow se aplican sólo la PRIMERA
# vez que se crea el volumen. Para cambiarlas después: docker compose down -v (borra los datos) y volver a levantar.

# ---------------------------------------------------------------------------
# Sistema
# ---------------------------------------------------------------------------
# ID del usuario del sistema operativo (en Linux/Mac ejecutar: id -u). airflow-init le da este dueño a dags/, logs/,
# plugins/, config/ y ddl/.
AIRFLOW_UID=1000

# ---------------------------------------------------------------------------
# Airflow - usuario de la interfaz web (http://localhost:8080)
# ---------------------------------------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# PostgreSQL de Airflow - servicio postgres_airflow (localhost:5433)
# Usuario administrador y base de metadatos interna de Airflow (no tocar)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Base auxiliar AMN dentro de postgres_airflow: simula el sistema origen.
# La usa la conexión de Airflow "amn_origen". Usar contraseñas sin caracteres especiales (@ : / ')
AMN_DB_USER=amn
AMN_DB_PASSWORD=amn123
AMN_DB_NAME=amn

# Airflow - claves internas
# FERNET_KEY encripta las contraseñas de las Connections y las Variables.
# Si queda vacía = se guardan sin encriptar (alcanza para uso local; Airflow muestra un warning). Para generar una:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# JWT_SECRET firma los tokens de la UI y la API: quien lo conoce puede entrar sin contraseña.
# Cambiarlo si el puerto 8080 queda accesible desde otra PC:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# ---------------------------------------------------------------------------
# MinIO - data lake (consola http://localhost:9001, API http://localhost:9000)
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

# ---------------------------------------------------------------------------
# PostgreSQL del data warehouse - servicio postgres_db (localhost:5432)
# Base local_db: esquemas bronze, silver y gold (AMN) y public (integrador 2).
# La usa la conexión de Airflow "postgres_dw". Usar contraseñas sin caracteres especiales (@ : /)
# ---------------------------------------------------------------------------
POSTGRES_DB=local_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# ---------------------------------------------------------------------------
# pgAdmin (http://localhost:5050)
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123
